#!/usr/bin/env bash
# PATH wrapper: Claude Code on ChatGPT Codex via llm-gateway.
# Extra args are forwarded to `claude` (so `claude-codex --help` is `claude --help`).
#
# Must not run under /bin/sh — helpers define hyphenated functions (cc-gateway-up).
# Install:
#   llm-gateway helpers install
#   ln -sf ~/.config/inja-gateway/scripts/claude-codex ~/.local/bin/claude-codex
#
# Env overrides: KEY CC_MODEL GATEWAY CLAUDE_BIN
# Optional: CC_ALLOW_DANGEROUSLY_SKIP_PERMISSIONS=1
# Does not start/restart the gateway (CC_SKIP_GATEWAY_UP=1).
set -e

# --help / --version: identical to `claude`, no gateway, no helper source.
for a in "$@"; do
  case "$a" in
    -h|--help|-v|--version)
      exec "${CLAUDE_BIN:-claude}" "$@"
      ;;
  esac
done

eval "$(llm-gateway helpers source)"

export KEY="${KEY:-local-dev}"
export CC_SKIP_GATEWAY_UP=1
if [[ -z "${CC_MODEL:-}" ]]; then
  export CC_MODEL="$(_inja_cc_pick_live_model chatgpt gpt)"
fi

extra=()
has_skip=0
for a in "$@"; do
  case "$a" in
    --allow-dangerously-skip-permissions) has_skip=1 ;;
  esac
done
if [[ "${CC_ALLOW_DANGEROUSLY_SKIP_PERMISSIONS:-}" == "1" && $has_skip -eq 0 ]]; then
  extra+=(--allow-dangerously-skip-permissions)
fi

# Function, not a binary — do not exec.
cc-gpt "${extra[@]}" "$@"
