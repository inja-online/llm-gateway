#!/usr/bin/env bash
# PATH wrapper: Claude Code on SuperGrok via llm-gateway.
# Extra args are forwarded to `claude` (so `claude-grok --help` is `claude --help`).
#
# Must not run under /bin/sh — helpers define hyphenated functions (cc-gateway-up).
# Install:
#   llm-gateway helpers install
#   ln -sf ~/.config/inja-gateway/scripts/claude-grok ~/.local/bin/claude-grok
#
# Env overrides: KEY CC_MODEL CC_GROK_HEAVY CLAUDE_CODE_EFFORT_LEVEL CLAUDE_BIN
# Optional: CC_ALLOW_DANGEROUSLY_SKIP_PERMISSIONS=1
set -e

# --help / --version: identical to `claude`, no gateway, no helper source.
for a in "$@"; do
  case "$a" in
    -h|--help|-v|--version)
      exec "${CLAUDE_BIN:-claude}" "$@"
      ;;
  esac
done

eval "$(llm-gateway helpers source)"

export KEY="${KEY:-local-dev}"
export CC_MODEL="${CC_MODEL:-grok-4.6}"
export CC_GROK_HEAVY="${CC_GROK_HEAVY:-grok-4.6}"
export CLAUDE_CODE_EFFORT_LEVEL="${CLAUDE_CODE_EFFORT_LEVEL:-xhigh}"
export ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES="${ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES:-effort,xhigh_effort,thinking,adaptive_thinking,interleaved_thinking}"
export ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES="${ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES:-effort,xhigh_effort,thinking,adaptive_thinking,interleaved_thinking}"

extra=()
has_effort=0
has_skip=0
for a in "$@"; do
  case "$a" in
    --effort|--effort=*) has_effort=1 ;;
    --allow-dangerously-skip-permissions) has_skip=1 ;;
  esac
done
[[ $has_effort -eq 0 ]] && extra+=(--effort xhigh)
if [[ "${CC_ALLOW_DANGEROUSLY_SKIP_PERMISSIONS:-}" == "1" && $has_skip -eq 0 ]]; then
  extra+=(--allow-dangerously-skip-permissions)
fi

# Function, not a binary — do not exec.
cc-grok "${extra[@]}" "$@"
